# Copy to /etc/ibshit.env and edit. Keep this file out of the repository.
#
# FORMAT: plain KEY=value, one per line. Do not quote values and do not put
# spaces inside them -- systemd strips quotes but a shell does not, so quoted or
# spaced values would work for the service and break the command-line tools.
#
#   sudo install -m 0640 -o root -g ibshit deploy/ibshit.env.example /etc/ibshit.env
#   sudo nano /etc/ibshit.env

# REQUIRED: a long random value. Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-openssl-rand-hex-32

FLASK_ENV=production

# SQLite by default (stored in the app's instance/ directory).
# For PostgreSQL, install postgresql and use:
# DATABASE_URL=postgresql+psycopg://ibshit:password@localhost/ibshit

# Quiz behaviour (optional overrides)
QUIZ_DEFAULT_COUNT=10
QUIZ_MAX_COUNT=60
QUIZ_FUZZY_THRESHOLD=72
QUIZ_NUMERIC_TOLERANCE=0.01

# Set this and /api/import + /api/export require an X-API-Key header.
# API_KEY=replace-me

# --- accounts --------------------------------------------------------------
# Set to 0 once everyone who needs an account has registered, and the sign-up
# page closes. Existing accounts keep working.
ALLOW_REGISTRATION=1
# Require this code to sign up. Leave commented for open registration.
# REGISTRATION_CODE=some-shared-secret

# --- behind HTTPS (nginx + certbot, or a tunnel) ---------------------------
# Uncomment both once the site is served over HTTPS.
# SESSION_COOKIE_SECURE=1
# PREFERRED_URL_SCHEME=https
# Only enable when a proxy you control sets the X-Forwarded-* headers.
# TRUST_PROXY_HEADERS=1
