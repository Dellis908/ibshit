# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Environment
.env
.env.*

# Databases & runtime data
instance/
*.db
*.sqlite3
data/pdfs/
data/extracted/

# Topic notes: hundreds of megabytes of PDFs, installed from a local folder with
#   python scripts/install_notes.py --source <folder>
# The manifest IS committed — it is small and tells the app which notes exist.
data/notes/*/
data/notes/*.pdf

# Content fetched from git.pirateib.sh.
# seed/rdojo.json is committed (it is the usable question bank); only the raw
# upstream download cache is ignored, since it can be rebuilt with:
#   python -m scraper.rdojo_import fetch --check-images
data/rdojo/
instance/images/

# Node (only used by the optional JS test)
node_modules/
package-lock.json
package.json

# OS / editors
.DS_Store
.idea/
.vscode/
